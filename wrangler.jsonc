{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zml-atlas",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/oauth2/*",
      "/login/*",
      "/logout",
      "/error"
    ]
  },
  "vars": {
    "ZML_CLOUD_ORIGIN": "https://example.invalid"
  }
}
